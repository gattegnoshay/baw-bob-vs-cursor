    <bpmn:serviceTask id="bpmnid-18a7de0f-30e6-556b-be36-aa16e885bccf" name="Dispatch Audit Event Underwriter Rejected">
      <bpmn:documentation>Server Script service flow. Formats JSON audit log: {timestamp, processInstanceId, customerId, finalDecision: REJECTED, riskLevel: HIGH_RISK, approver: approvalDecision.processedBy, reason: approvalDecision.approverComments}. Outputs to system log or HTTP audit endpoint.</bpmn:documentation>
      <bpmn:performer id="bpmnid-c48151cd-15fe-5d5a-8150-967b303620d4" name="System"/>
      <bpmn:ioSpecification id="bpmnid-f8e09eb3-12ea-530f-b9eb-620d930a321c">
        <bpmn:dataInput id="bpmnid-5e7a593c-bbd8-55d6-ad4e-2be95562bc52" name="customerInfo" itemSubjectRef="bpmnid-04681c88-3ff2-54f6-b48f-a98e3868c5c0"/>
        <bpmn:dataInput id="bpmnid-52c35c86-d8a3-57f7-8564-28c53eeba359" name="riskAssessment" itemSubjectRef="bpmnid-00f87e6d-7654-51d0-b518-9c303c31a3c8"/>
        <bpmn:dataInput id="bpmnid-b64adfe4-06c1-53a1-94a8-1ac68e54e81f" name="approvalDecision" itemSubjectRef="bpmnid-c7b42249-4f20-5d27-b9f4-ddc3015e73d9"/>
        <bpmn:inputSet id="bpmnid-1da58752-dd8a-5ce7-80b2-d12600b622cc">
          <bpmn:dataInputRefs>bpmnid-5e7a593c-bbd8-55d6-ad4e-2be95562bc52</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>bpmnid-52c35c86-d8a3-57f7-8564-28c53eeba359</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>bpmnid-b64adfe4-06c1-53a1-94a8-1ac68e54e81f</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="bpmnid-f5f8643e-4c80-53ff-9e36-b6d60d2c23e3"/>
      </bpmn:ioSpecification>
    </bpmn:serviceTask>
    <bpmn:endEvent id="bpmnid-12a361cb-ad07-58eb-9efc-a9e7abf13520" name="Auto Approved">
      <bpmn:documentation>Process ends successfully with automatic approval. Core Banking limit updated.</bpmn:documentation>
    </bpmn:endEvent>
    <bpmn:endEvent id="bpmnid-10593819-c31c-54ca-b2bf-5f4fa0f31dab" name="Auto Rejected">
      <bpmn:documentation>Process ends with automatic rejection due to credit score below minimum threshold (&lt; 650).</bpmn:documentation>
    </bpmn:endEvent>
    <bpmn:endEvent id="bpmnid-8a73fe31-3eb1-5c8a-9daf-e6acb821e001" name="Underwriter Approved">
      <bpmn:documentation>Process ends with underwriter approval. Core Banking limit updated and audit logged.</bpmn:documentation>
    </bpmn:endEvent>
    <bpmn:endEvent id="bpmnid-368fa767-16a8-552e-b63b-c3b07885c4dd" name="Underwriter Rejected">
      <bpmn:documentation>Process ends with underwriter rejection. Audit event logged with reason and approver comments.</bpmn:documentation>
    </bpmn:endEvent>
    <bpmn:endEvent id="bpmnid-fd0c5c85-7c36-5212-9061-540d2d17b907" name="Escalation Sent">
      <bpmn:documentation>Escalation notification dispatched to manager. Underwriter task continues independently.</bpmn:documentation>
    </bpmn:endEvent>
