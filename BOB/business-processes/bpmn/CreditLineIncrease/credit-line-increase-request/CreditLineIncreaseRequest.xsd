<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://CLIR/BusinessObjects" targetNamespace="http://CLIR/BusinessObjects" elementFormDefault="qualified" attributeFormDefault="unqualified">
  <complexType name="CustomerInfo">
    <annotation>
      <documentation>Captures all customer data submitted in the credit line increase request form. Used by risk engine, banking integration, and audit steps.</documentation>
    </annotation>
    <sequence>
      <element name="customerID" type="string" minOccurs="1"/>
      <element name="fullName" type="string" minOccurs="1"/>
      <element name="creditScore" type="integer" minOccurs="1"/>
      <element name="annualIncome" type="decimal" minOccurs="1"/>
      <element name="currentLimit" type="decimal" minOccurs="1"/>
      <element name="requestedIncrease" type="decimal" minOccurs="1"/>
      <element name="submissionDate" type="dateTime" minOccurs="0"/>
      <element name="channel" type="string" minOccurs="0"/>
    </sequence>
  </complexType>
  <complexType name="RiskAssessment">
    <annotation>
      <documentation>Output of the Risk Assessment Engine. riskLevel values: LOW_RISK, HIGH_RISK, AUTO_REJECT. autoApproved is true only when riskLevel=LOW_RISK.</documentation>
    </annotation>
    <sequence>
      <element name="riskLevel" type="string" minOccurs="1"/>
      <element name="riskReason" type="string" minOccurs="0"/>
      <element name="autoApproved" type="boolean" minOccurs="0"/>
      <element name="assessedDate" type="dateTime" minOccurs="0"/>
      <element name="engineVersion" type="string" minOccurs="0"/>
    </sequence>
  </complexType>
  <complexType name="ApprovalDecision">
    <annotation>
      <documentation>Final credit line decision. status values: APPROVED, REJECTED, PENDING_UNDERWRITER. processedBy is the underwriter user ID or 'SYSTEM' for automated decisions.</documentation>
    </annotation>
    <sequence>
      <element name="status" type="string" minOccurs="1"/>
      <element name="approvedAmount" type="decimal" minOccurs="0"/>
      <element name="approverComments" type="string" minOccurs="0"/>
      <element name="processedBy" type="string" minOccurs="0"/>
      <element name="decisionTimestamp" type="dateTime" minOccurs="0"/>
      <element name="bankingTxId" type="string" minOccurs="0"/>
    </sequence>
  </complexType>
</schema>
